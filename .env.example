# ---------------------------------------------------------------------------
# Tutor UG frontend configuration
#
# Copy this file to `.env` (or `.env.local`) and adjust the values.
# Every variable is prefixed with VITE_ so Vite exposes it to the browser.
# ---------------------------------------------------------------------------

# Base URL of the Spring Boot REST API. No trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Request timeout in milliseconds.
VITE_API_TIMEOUT=20000

# Auth strategy:
#   cookie  -> backend sets an HttpOnly cookie; client sends credentials with
#              every request and restores the session via GET /api/auth/me
#   bearer  -> backend returns a token; the client keeps it in memory and
#              mirrors it to sessionStorage (never localStorage)
VITE_AUTH_MODE=cookie

# Run the app against the in-browser mock services instead of the real API.
# Demo mode is always shown to the user in a banner.
VITE_DEMO_MODE=false

# Only enable once the backend exposes POST /api/auth/forgot-password.
# While this is false the app says plainly that password reset is not
# available yet — it never pretends an email was sent.
VITE_PASSWORD_RESET_ENABLED=false
